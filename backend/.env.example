# Porta HTTP da API (padrão 3000)
PORT=3000

# Origem do frontend liberada no CORS, sem caminho e sem barra no final
FRONTEND_ORIGIN=http://localhost:5173

# Conexão com o PostgreSQL do docker-compose.yml (porta 5433 do computador)
DATABASE_URL=postgresql://passe:passe@localhost:5433/passe?schema=public
